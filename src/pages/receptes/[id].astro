---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { dataLlarga, etiquetaTipus, portada, url, type Recepta } from '../../lib/receptes';

export async function getStaticPaths() {
  const receptes = await getCollection('receptes');
  return receptes.map((r) => ({ params: { id: r.id }, props: { r } }));
}

const { r } = Astro.props as { r: Recepta };
const { Content } = await render(r);
const foto = portada(r.id);
const d = r.data;
// Les vistes prèvies de WhatsApp i companyia volen JPG, no WebP.
const imatgeCompartir = foto ? (await getImage({ src: foto, width: 1200, format: 'jpg' })).src : undefined;
const descripcio = `${etiquetaTipus(r)} · ${d.racions} racions · ${d.categoria}`;
---
<Base title={`${d.titol} · Cuina amb mi`} description={descripcio} imatge={imatgeCompartir}>
  <main>
    <a class="back" href={url()}>← Receptes</a>

    <section class="r-head">
      <div class="txt">
        <span class={`badge ${d.tipus}`}>{etiquetaTipus(r)}</span>
        <h1>{d.titol}</h1>
        {d.tipus === 'participada'
          ? <p class="origen">Hi vaig participar: <b>{d.origen}</b> · {dataLlarga(d.data)}</p>
          : <p class="origen">Feta el {dataLlarga(d.data)}</p>}
        <div class="facts" id="racions" data-base={d.racions}>
          <div>
            <small>Racions</small>
            <span class="serv">
              <button type="button" data-d="-1" aria-label="Menys racions">−</button>
              <b id="serv-n" aria-live="polite">{d.racions}</b>
              <button type="button" data-d="1" aria-label="Més racions">+</button>
            </span>
          </div>
          <div>
            <small>Quantitats</small>
            <button class="reset" id="reset" type="button" disabled>Recepta original · {d.racions} racions</button>
          </div>
        </div>
        <p class="nomes-print" id="racions-print">Per a {d.racions} racions</p>
        <div class="accions">
          <button class="boto" id="compartir" type="button" data-titol={d.titol}>Comparteix</button>
          <button class="boto" id="pdf" type="button">Imprimeix o desa en PDF</button>
          <span class="avis-copiat" id="copiat" role="status" aria-live="polite"></span>
        </div>
      </div>
      {foto && <Image class="r-foto" src={foto} alt={d.titol} width={900} />}
    </section>

    <div class="r-body">
      <p class="note-text" id="avis-racions" hidden></p>
      <Content />
    </div>
  </main>
</Base>

<script>
  // Recalcula les quantitats marcades dels ingredients segons les racions triades.
  const caixa = document.getElementById('racions')!;
  const base = Number(caixa.dataset.base);
  const nEl = document.getElementById('serv-n')!;
  const reset = document.getElementById('reset') as HTMLButtonElement;
  const avis = document.getElementById('avis-racions')!;
  const qtys = [...document.querySelectorAll<HTMLElement>('.qty')];
  const FR: Record<string, string> = { '0.25': '¼', '0.5': '½', '0.75': '¾' };
  let n = base;

  // Pes i volum: càlcul exacte. Peces que es compten (ous, cebes...): número sencer, mínim 1,
  // tret que la recepta original ja en posi una fracció (½ culleradeta).
  function format(q: number, u: string, original: number) {
    if (!u && Number.isInteger(original)) return String(Math.max(1, Math.round(q)));
    if (q >= 50 && (u === 'g' || u === 'ml')) return String(Math.round(q / 5) * 5);
    let v = Math.round(q * 4) / 4;
    if (v === 0) v = 0.25;
    const sencer = Math.floor(v);
    return `${sencer || ''}${FR[String(v - sencer)] ?? ''}`;
  }

  function pinta() {
    const k = n / base;
    for (const el of qtys) {
      const u = el.dataset.u ?? '';
      const original = Number(el.dataset.q);
      const exacte = original * k;
      // «≈» quan una peça s'ha hagut d'arrodonir (0,8 ous → ≈ 1).
      const arrodonit = !u && Number.isInteger(original) && Math.abs(Math.max(1, Math.round(exacte)) - exacte) > 0.01;
      el.textContent = (arrodonit ? '≈ ' : '') + format(exacte, u, original) + (u ? ` ${u}` : '');
    }
    nEl.textContent = String(n);
    reset.disabled = n === base;
    avis.hidden = n === base;
    avis.textContent = `Quantitats aproximades per a ${n} racions (la recepta original és per a ${base}). Les marcades amb ≈ s'han arrodonit.`;
    document.getElementById('racions-print')!.textContent =
      n === base ? `Per a ${n} racions` : `Per a ${n} racions (quantitats aproximades; la recepta original és per a ${base})`;
  }

  caixa.querySelectorAll<HTMLButtonElement>('[data-d]').forEach((b) =>
    b.addEventListener('click', () => {
      n = Math.max(1, Math.min(40, n + Number(b.dataset.d)));
      pinta();
    }),
  );
  reset.addEventListener('click', () => {
    n = base;
    pinta();
  });

  // El PDF surt amb les racions triades; el diàleg d'imprimir del navegador permet desar-lo com a PDF.
  document.getElementById('pdf')!.addEventListener('click', () => window.print());

  // Comparteix: al mòbil obre el menú de compartir del sistema (WhatsApp, correu...);
  // si el navegador no en té, copia l'enllaç.
  const compartir = document.getElementById('compartir')!;
  const copiat = document.getElementById('copiat')!;
  compartir.addEventListener('click', async () => {
    const dades = { title: `${compartir.dataset.titol} · Cuina amb mi`, url: location.href.split('#')[0] };
    if (navigator.share) {
      try {
        await navigator.share(dades);
        return;
      } catch (e) {
        if ((e as Error).name === 'AbortError') return;
      }
    }
    try {
      await navigator.clipboard.writeText(dades.url);
      copiat.textContent = 'Enllaç copiat';
    } catch {
      copiat.textContent = dades.url;
    }
    setTimeout(() => (copiat.textContent = ''), 4000);
  });
</script>
